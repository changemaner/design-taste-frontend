{
  "version": 1,
  "middle_slides": {
    "from": 2,
    "to": 6,
    "note": "0-based slide indexes; exclude cover (0), agenda/intro (1) and closing (7) from the convergence gate."
  },
  "generic_tokens": [
    "slide",
    "frame",
    "reveal",
    "wordmark",
    "tag",
    "body",
    "body-muted",
    "body-cream",
    "body-on-color",
    "h-title",
    "h-heading",
    "h-sm",
    "d1",
    "d2",
    "d3",
    "d4",
    "card",
    "card-body",
    "card-title",
    "card-kicker",
    "card-num",
    "quote-by",
    "quote-text",
    "stat-label",
    "stat-num",
    "stat-num-sm",
    "nav-pill",
    "nav-bar",
    "tag-pill",
    "logo"
  ],
  "families": {
    "data": {
      "label": "数据",
      "expression": "真正的数据卡或图表",
      "signals": [
        "data-card",
        "chart-*",
        "tbl",
        "table-rows",
        "metric",
        "kpi",
        "spark-*",
        "graph-*",
        "plot-*",
        "waveform",
        "pipeline",
        "result-*",
        "results"
      ]
    },
    "newspaper": {
      "label": "报纸",
      "expression": "多栏排版",
      "signals": [
        "agenda-*",
        "release-card",
        "three-cards",
        "paper-card",
        "ink-card",
        "journal-card",
        "read-*",
        "press-card",
        "proc-*",
        "column",
        "columns",
        "broadsheet",
        "masthead"
      ]
    },
    "illustration": {
      "label": "插画",
      "expression": "整幅插画 + 旁注",
      "signals": [
        "hero-art",
        "art-*",
        "product-art",
        "botanical",
        "sketch",
        "glyph",
        "mascot",
        "crayon-*",
        "molten",
        "marble",
        "illustration",
        "illustration-*"
      ]
    },
    "product": {
      "label": "产品",
      "expression": "产品实体 / UI artifact",
      "signals": [
        "artifact",
        "console",
        "commandbar",
        "window",
        "product-card",
        "product-art",
        "specimen",
        "desk-card",
        "obj-*",
        "pebble-card",
        "plan-card",
        "sharp-card",
        "split",
        "device",
        "screen",
        "mockup"
      ]
    },
    "playful": {
      "label": "活泼",
      "expression": "贴纸、注释、手写箭头",
      "signals": [
        "sticker",
        "chip-*",
        "confetti",
        "checker-*",
        "pixel-*",
        "sketch",
        "crayon-*",
        "tilt-*",
        "tag-*",
        "badge",
        "emoji",
        "marble",
        "note-card",
        "doodle",
        "zigzag-*"
      ]
    },
    "industrial": {
      "label": "工业",
      "expression": "编号、规格表、工程标注",
      "signals": [
        "blueprint-*",
        "spec",
        "specification",
        "panel-num",
        "card-num",
        "a-num",
        "r-num",
        "obj-num",
        "proc-num",
        "read-index",
        "serial",
        "dimension",
        "measure",
        "callout",
        "engineering",
        "protocol",
        "register"
      ]
    }
  },
